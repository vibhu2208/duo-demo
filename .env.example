# =============================================================================
# LOCAL DEVELOPMENT — copy to .env and edit (repo root)
# =============================================================================

# --- Database & cache ---
DATABASE_URL=postgresql://jira_ai:jira_ai_secret@localhost:5432/jira_intelligence
REDIS_URL=redis://localhost:6379

# --- JWT (backend) ---
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# --- AI provider (shared; ai-service reads these) ---
# gitlab = GitLab Duo | openai = OpenAI | mock = template demo only
AI_PROVIDER=gitlab
EMBEDDING_PROVIDER=local
USE_CHROMA=false

# --- GitLab on-prem (code security + shared with ai-service for Duo) ---
GITLAB_URL=https://gitlab.engine-onprem.capgemini.com
GITLAB_TOKEN=glpat-your-token-here
# Optional: limit project list to a GitLab group path
GITLAB_DEFAULT_GROUP=
# Set true for internal GitLab with self-signed TLS
GITLAB_INSECURE_SSL=false
# Optional: numeric project ID for project-scoped Duo; leave empty for instance-level
GITLAB_PROJECT_ID=

# --- OpenAI (only when AI_PROVIDER=openai) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- ChromaDB (only when USE_CHROMA=true) ---
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=jira_tickets

# --- Jira (backend; or set via Admin UI) ---
# Internal Jira Server / Data Center (default):
JIRA_BASE_URL=https://jira.your-company.internal
JIRA_USERNAME=your-jira-username
JIRA_API_TOKEN=your-jira-password-or-personal-access-token
JIRA_DEPLOYMENT=server
# Set true only if your internal Jira uses a self-signed TLS certificate
JIRA_INSECURE_SSL=false
JIRA_PROJECT_KEY=PROJ

# Jira Cloud (use JIRA_DEPLOYMENT=cloud and email-style username):
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_USERNAME=your-email@company.com
# JIRA_API_TOKEN=your-atlassian-api-token
# JIRA_DEPLOYMENT=cloud

# --- GitHub (backend; or set via Admin UI) ---
# PAT scopes: repo (private repos) or public_repo (public only)
GITHUB_TOKEN=ghp_your-token-here
GITHUB_DEFAULT_OWNER=

# --- Local service URLs ---
BACKEND_PORT=3001
# If port 3001 is in use by another app, change to e.g. 3010 and restart backend + frontend
AI_SERVICE_PORT=3002
AI_SERVICE_URL=http://localhost:3002
FRONTEND_URL=http://localhost:5173

# --- Seed admin (backend; created on first migrate/start) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123


# =============================================================================
# RENDER: AI SERVICE — Root Directory: ai-service
# Set these ONLY in Render dashboard (Environment). Do not commit real tokens.
# =============================================================================
#
# | Variable              | What to set
# |-----------------------|--------------------------------------------------
# | AI_SERVICE_PORT       | ${PORT}  (Render injects PORT; app listens on it)
# | AI_PROVIDER           | gitlab   (or openai | mock)
# | GITLAB_URL            | https://gitlab.engine-onprem.capgemini.com
# | GITLAB_TOKEN          | your real glpat-... token
# | GITLAB_PROJECT_ID     | (leave empty) or e.g. 12345 if you use a project
# | EMBEDDING_PROVIDER    | local
# | USE_CHROMA            | false
# | OPENAI_API_KEY        | (only if AI_PROVIDER=openai)
# | OPENAI_CHAT_MODEL     | (optional) gpt-4.1-mini
# | OPENAI_EMBEDDING_MODEL| (optional) text-embedding-3-small
#
# --- Copy/paste block for Render (ai-service) ---
# AI_SERVICE_PORT=${PORT}
# AI_PROVIDER=gitlab
# GITLAB_URL=https://gitlab.engine-onprem.capgemini.com
# GITLAB_TOKEN=glpat-your-token-here
# GITLAB_PROJECT_ID=
# EMBEDDING_PROVIDER=local
# USE_CHROMA=false
#
# Do NOT set on ai-service: DATABASE_URL, REDIS_URL, JWT_*, JIRA_*, AI_SERVICE_URL,
# FRONTEND_URL, BACKEND_PORT, CHROMA_URL (unless USE_CHROMA=true)
#
# Health check after deploy: https://<your-ai-service>.onrender.com/health


# =============================================================================
# RENDER: BACKEND — Root Directory: backend
# =============================================================================
#
# DATABASE_URL=<neon-postgres-url>
# REDIS_URL=<upstash-or-render-redis-url>
# JWT_SECRET=<long-random-string>
# JWT_EXPIRES_IN=7d
# AI_SERVICE_URL=https://duo-demo.onrender.com
# FRONTEND_URL=https://<your-app>.vercel.app
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=admin123
#
# Do NOT set on backend: GITLAB_TOKEN, AI_PROVIDER, OPENAI_* (those stay on ai-service)


# =============================================================================
# VERCEL: FRONTEND — Root Directory: frontend
# =============================================================================
#
# No env vars required. API proxy is in frontend/vercel.json → backend URL.
