# Database
DATABASE_URL=postgresql://jira_ai:jira_ai_secret@localhost:5432/jira_intelligence
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# AI Provider: gitlab (Duo) | openai | mock (hardcoded templates — dev only)
AI_PROVIDER=gitlab
EMBEDDING_PROVIDER=local
USE_CHROMA=false

# GitLab Duo (when AI_PROVIDER=gitlab)
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=glpat-your-token
GITLAB_PROJECT_ID=

# OpenAI (optional — when AI_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ChromaDB
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=jira_tickets

# Jira (set via Admin UI or here for initial sync)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=PROJ

# Services (local dev)
BACKEND_PORT=3001
AI_SERVICE_PORT=3002
AI_SERVICE_URL=http://localhost:3002
FRONTEND_URL=http://localhost:5173

# Production (Render + Vercel) — set in platform dashboards, not committed
# AI_SERVICE_URL=https://duo-demo.onrender.com
# BACKEND public URL for vercel.json: https://duo-demo-wq9t.onrender.com
# FRONTEND_URL=https://<your-app>.vercel.app

# Seed admin (first run)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123
